# Tek sunucuda kalıcı, yalnız uygulama kullanıcısının erişebildiği disk yolu.
SHIFTSCAN_DB_PATH=/app/data/shiftscan.sqlite3
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Üretilen değeri secret yöneticisine koyun; Git'e eklemeyin. Bu anahtar değişirse
# önceki sağlayıcı bağlantıları çözülemez. DB ile ayrı ve güvenli yedekleyin.
SHIFTSCAN_ENCRYPTION_KEY=
# Canlı HTTPS'te true. Yalnız localhost HTTP geliştirmesinde false.
SHIFTSCAN_SECURE_COOKIES=true
# Ortak sunucu anahtarına sessiz fallback yapılmaz. Demo kullanımı açık tercihtir.
SHIFTSCAN_DEMO_AI=false
# Eski paylaşımlı HuggingFace OCR yolu varsayılan kapalı; kullanıcı OCR'ı BYOK/yerel.
SHIFTSCAN_LEGACY_OCR=false
